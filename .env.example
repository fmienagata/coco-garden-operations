# À configurer lors du raccordement des services. Ne jamais committer les secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# DB provider: set to `mongo` to enable DB checks in development
DB_PROVIDER=mongo
# For MongoDB, a connection string like: mongodb://user:pass@host:27017/dbname
MONGO_URI=
